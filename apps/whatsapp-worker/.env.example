# Empresa dona desta sessão de WhatsApp — cada empresa roda seu próprio
# processo whatsapp-worker (uma sessão = um número = uma empresa).
EMPRESA_ID=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Trava de segurança do MVP 1 da camada de IA — ver apps/ai-orchestrator.
# Enquanto false, respostas da IA nunca são enviadas de verdade pelo
# WhatsApp (só logadas e marcadas como simuladas). Mudar pra true é uma
# decisão explícita separada, depois de validar com o gabarito (Passo 7).
IA_ENVIO_REAL=false
