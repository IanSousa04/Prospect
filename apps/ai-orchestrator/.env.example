# Empresa atendida por este processo — mesmo padrão do whatsapp-worker (um
# processo por empresa nesta fase).
EMPRESA_ID=

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Intervalo (ms) do polling que busca mensagens novas do cliente para
# processar. A trava de segurança do MVP 1 (enviar de verdade ou não) mora
# no whatsapp-worker (IA_ENVIO_REAL) — este processo sempre investiga e
# grava a resposta, quem decide entregar de verdade é o poller do WhatsApp.
POLLING_INTERVALO_MS=3000
